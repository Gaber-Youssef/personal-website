---
import { PERSONAL } from '../config';
const { includeSidebar = false } = Astro.props;
---
<header class:list={['sticky top-0 z-30 border-b border-surface-light bg-canvas/95 backdrop-blur', { 'lg:hidden': includeSidebar }]}>
  <nav aria-label="Main navigation" class="mx-auto flex min-h-[4.5rem] max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-3">
    <a class="font-display text-base font-semibold text-ink hover:text-brand" href="/">{PERSONAL.name}</a>
    <div class="flex items-center gap-5 text-sm text-muted-light">
      <a href="/" class="hover:text-brand">Home</a>
      <a href="/blog" class="hover:text-brand" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>Blog</a>
      <a href="/#contact" class="hover:text-brand">Contact</a>
      {includeSidebar && (
        <label for="my-drawer" class="cursor-pointer text-brand">More</label>
      )}
    </div>
  </nav>
</header>
