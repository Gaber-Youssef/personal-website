---
import { TESTIMONIALS, PERSONAL } from '../../config';
---

<section id="testimonials" class="relative">
  
  <div class="section-container relative z-10">
    
    <!-- Section header -->
    <div class="section-header" data-animate>
      <span class="section-label">Client Words</span>
      <h2 class="section-title">What they're saying.</h2>
      <p class="section-subtitle">
        Hear from leaders I've partnered with.
      </p>
    </div>

    <!-- Testimonials -->
    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {TESTIMONIALS.map((testimonial) => (
        <div 
          class="testimonial-card"
          data-animate
        >
          <blockquote class="relative z-10">
            <p class="text-lg text-muted-light leading-relaxed mb-6 italic">
              "{testimonial.quote}"
            </p>
            <footer class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-brand-soft flex items-center justify-center">
                <span class="text-brand font-display font-medium text-lg">
                  {testimonial.author.charAt(0)}
                </span>
              </div>
              <div>
                <div class="text-ink font-medium">{testimonial.author}</div>
                <div class="text-sm text-muted">{testimonial.company}</div>
              </div>
            </footer>
          </blockquote>
        </div>
      ))}
    </div>

    <!-- Upwork is one source of feedback within a broader career. -->
    <p class="mt-10 max-w-2xl mx-auto text-center text-sm text-muted" data-animate>
      Alongside my direct client work and company roles, I take on selected projects through Upwork,
      where I hold Expert-Vetted status and a 100% Job Success score.
      <a href={PERSONAL.upwork} target="_blank" rel="noopener noreferrer" class="text-brand underline underline-offset-4">Read more client feedback on Upwork →</a>
    </p>

    <!-- Simple process overview -->
    <div class="mt-12 md:mt-16 pt-10 border-t border-surface-light max-w-4xl mx-auto" data-animate>
      <h3 class="text-center text-xl font-display font-medium text-ink mb-8">
        Simple process. Real outcomes.
      </h3>
      <div class="grid sm:grid-cols-3 gap-6">
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-brand/10 border border-brand/20 flex items-center justify-center mx-auto mb-4">
            <span class="text-brand font-display font-medium">1</span>
          </div>
          <h4 class="text-ink font-medium mb-2">Discovery Call</h4>
          <p class="text-sm text-muted-light">
            30 minutes to understand your challenge and see if we're a fit.
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-brand/10 border border-brand/20 flex items-center justify-center mx-auto mb-4">
            <span class="text-brand font-display font-medium">2</span>
          </div>
          <h4 class="text-ink font-medium mb-2">Proposal</h4>
          <p class="text-sm text-muted-light">
            Clear scope, timeline, and investment — no surprises.
          </p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 rounded-full bg-brand/10 border border-brand/20 flex items-center justify-center mx-auto mb-4">
            <span class="text-brand font-display font-medium">3</span>
          </div>
          <h4 class="text-ink font-medium mb-2">Delivery</h4>
          <p class="text-sm text-muted-light">
            Transparent progress with regular check-ins until you're delighted.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
