---
import { PERSONAL, COMPANY, CREDENTIALS, RESULTS } from '../../config';
---

<section class="pt-28 pb-12 md:pt-32 md:pb-14 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 relative z-10">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center max-w-6xl mx-auto">
      
      <!-- Left: Content -->
      <div class="hero-intro order-2 lg:order-1 text-center lg:text-left">
        
        <!-- Availability status -->
        <div>
          <div class="status-badge inline-flex mb-6">
            <span class="status-dot"></span>
            <span class="text-muted-light">Currently accepting new clients</span>
          </div>
        </div>

        <!-- Main headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-hero font-display font-medium text-ink mb-6 text-balance">
          Let's build AI systems
          <span class="block mt-2 emphasis-text">that actually work.</span>
        </h1>

        <p class="text-sm mb-5">
          <a href={COMPANY.url} target="_blank" rel="noopener noreferrer" class="text-brand font-medium underline underline-offset-4 hover:text-brand-light">
            Owner of {COMPANY.name}
          </a>
        </p>

        <!-- Value proposition -->
        <p class="text-base sm:text-lg text-muted-light max-w-xl mx-auto lg:mx-0 mb-6 leading-relaxed">
          I help ambitious companies implement AI that actually works — 
          from strategy through production. My experience spans enterprise teams in
          consumer goods, healthcare, and financial services, as well as high-growth startups.
        </p>

        <!-- Credentials -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 mb-8">
          {CREDENTIALS.map((cred) => (
            <div class="credential-badge text-xs">
              <span class="text-brand">✓</span>
              <span class="text-muted-light">{cred.label}</span>
            </div>
          ))}
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
          <a 
            href={PERSONAL.callUrl}
            target={PERSONAL.callUrl.startsWith("https:") ? "_blank" : undefined}
            rel="noopener noreferrer" 
            class="btn-primary text-base group"
          >
            <span>Arrange a Strategy Call</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a 
            href="#results" 
            class="btn-secondary text-base"
          >
            See Results
          </a>
        </div>

        <!-- Key metrics -->
        <div class="grid grid-cols-3 gap-4 max-w-md mx-auto lg:mx-0">
          {RESULTS.map((result) => (
            <div class="text-center lg:text-left">
              <div class="text-xl sm:text-2xl font-display font-medium text-ink">{result.metric}</div>
              <div class="text-xs text-muted mt-0.5">{result.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Photo - Clean and Centered -->
      <div class="hero-photo order-1 lg:order-2 flex justify-center">
        <div class="relative">
          
          <!-- Photo container - centered with rounded corners -->
          <div class="relative w-60 h-60 sm:w-80 sm:h-80 md:w-96 md:h-96 rounded-3xl overflow-hidden shadow-card border border-brand/10">
            <img 
              src="/gaber-headshot.jpg" 
              alt="Gaber Youssef - AI Strategy & Implementation Partner"
              class="w-full h-full object-cover object-center"
              loading="eager"
            />
          </div>
          
          <!-- Floating badge -->
          <div class="absolute -bottom-4 -right-4 sm:-bottom-5 sm:-right-5 bg-surface border border-surface-light rounded-xl px-4 py-3 shadow-soft">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg bg-brand-soft border border-brand/30 flex items-center justify-center">
                <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium text-ink">Top 1%</div>
                <div class="text-xs text-muted">Expert-Vetted</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <a href="#why-me" class="hidden md:flex items-center justify-center gap-2 mt-10 text-xs uppercase tracking-widest text-muted hover:text-brand transition-colors">
      Discover more
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-intro { animation: hero-enter 400ms cubic-bezier(0.22, 1, 0.36, 1) both; }
    .hero-photo { animation: hero-enter 400ms 80ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  }
  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
