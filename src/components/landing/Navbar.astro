---
import { PERSONAL } from '../../config';
---

<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-void/90 border-b border-carbon-light/50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between h-18">
      <!-- Name -->
      <a href="/" class="group">
        <span class="font-display font-semibold text-lg text-cream group-hover:text-gold transition-colors">{PERSONAL.name}</span>
        <span class="hidden sm:block text-xs text-stone">{PERSONAL.title}</span>
      </a>

      <!-- Navigation Links -->
      <div class="hidden md:flex items-center gap-10">
        <a href="#why-me" class="text-sm text-stone-light hover:text-gold transition-colors">How I Help</a>
        <a href="#results" class="text-sm text-stone-light hover:text-gold transition-colors">Results</a>
        <a href="#services" class="text-sm text-stone-light hover:text-gold transition-colors">Work Together</a>
        <a href="#testimonials" class="text-sm text-stone-light hover:text-gold transition-colors">Testimonials</a>
      </div>

      <!-- CTA Button -->
      <div class="flex items-center gap-4">
        <a 
          href={PERSONAL.calendarUrl} 
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-sm py-2.5 px-5"
        >
          <span>Let's Talk</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button 
          class="md:hidden p-2 text-stone-light hover:text-gold transition-colors"
          id="mobile-menu-btn"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-carbon-light/50 bg-void/95 backdrop-blur-md">
    <div class="px-6 py-6 space-y-5">
      <a href="#why-me" class="block text-stone-light hover:text-gold transition-colors">How I Help</a>
      <a href="#results" class="block text-stone-light hover:text-gold transition-colors">Results</a>
      <a href="#services" class="block text-stone-light hover:text-gold transition-colors">Work Together</a>
      <a href="#testimonials" class="block text-stone-light hover:text-gold transition-colors">Testimonials</a>
      <div class="pt-4 border-t border-carbon-light/50">
        <a 
          href={PERSONAL.calendarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary w-full justify-center text-sm"
        >
          Book a Call
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Close menu when clicking a link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
    });
  });
</script>
