---
import { EXPERIENCES, CLIENT_INDUSTRIES } from '../../config';
---

<section id="results" class="relative">
  
  <div class="section-container relative z-10">
    
    <!-- Section header -->
    <div class="section-header section-header-left" data-animate>
      <span class="section-label">Track Record</span>
      <h2 class="section-title">Results that speak for themselves.</h2>
      <p class="section-subtitle">
        Real outcomes from real projects. No hypotheticals — just measurable impact.
      </p>
    </div>

    <!-- Results timeline -->
    <div class="max-w-4xl mx-auto space-y-5 md:space-y-6">
      {EXPERIENCES.map((exp) => (
        <div 
          class="timeline-card group"
          data-animate
        >
          <div class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10">
            
            <!-- Metric highlight -->
            <div class="lg:w-40 shrink-0 text-center lg:text-left">
              <div class="timeline-metric">{exp.metric}</div>
              <div class="text-sm text-muted uppercase tracking-wide">{exp.metricLabel}</div>
            </div>

            <!-- Content -->
            <div class="flex-1">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
                <h3 class="text-xl font-display font-medium text-ink">
                  {exp.outcome}
                </h3>
                <div class="flex items-center gap-2 text-sm text-muted">
                  {exp.companyUrl ? (
                    <a
                      href={exp.companyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-brand font-medium underline underline-offset-4 hover:text-brand-light"
                    >
                      {exp.company}
                    </a>
                  ) : (
                    <span class="text-brand font-medium">{exp.company}</span>
                  )}
                  <span>·</span>
                  <span>{exp.period}</span>
                </div>
              </div>
              <p class="text-muted-light leading-relaxed">
                {exp.story}
              </p>
              <div class="mt-3 text-sm text-muted">
                Role: <span class="text-muted-light">{exp.role}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Client trust bar -->
    <div class="mt-10 md:mt-12 pt-8 border-t border-surface-light max-w-4xl mx-auto grid md:grid-cols-[10rem_1fr] gap-5 md:gap-8 items-start" data-animate>
      <p class="text-xs text-muted uppercase tracking-widest leading-relaxed">
        Experience across industries
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-3">
        {CLIENT_INDUSTRIES.map((client) => (
          <span class="text-sm text-muted font-medium">
            {client}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
