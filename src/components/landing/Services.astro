---
import { SERVICES, PERSONAL, COMPANY } from '../../config';

const icons = {
  partnership: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
  </svg>`,
  build: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
  </svg>`,
  audit: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
  </svg>`,
};
---

<section id="services" class="relative">
  <div class="section-container">

    <!-- Section header -->
    <div class="section-header" data-animate>
      <span class="section-label">Work Together</span>
      <h2 class="section-title">Choose how we partner.</h2>
      <p class="section-subtitle">
        Every engagement includes direct access to me — no account managers, no layers.
        Just senior expertise focused on your success.
      </p>
    </div>

    <!-- Services grid -->
    <div class="grid lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {SERVICES.map((service) => {

        return (
          <div
            class="service-card group"
            data-animate
          >
            <!-- Icon -->
            <div class="w-14 h-14 rounded-xl bg-brand-soft border border-brand/15 flex items-center justify-center mb-6">
              <span class="text-brand">
                <Fragment set:html={icons[service.icon as keyof typeof icons]} />
              </span>
            </div>

            <!-- Title & subtitle -->
            <h3 class="text-xl font-display font-medium text-ink mb-1">
              {service.title}
            </h3>
            <p class="text-sm text-muted mb-4">{service.subtitle}</p>

            <!-- Description -->
            <p class="text-muted-light text-sm leading-relaxed mb-6">
              {service.description}
            </p>

            <!-- Benefits -->
            <div class="space-y-2.5 mb-6">
              {service.benefits.map((benefit) => (
                <div class="flex items-start gap-3 text-sm">
                  <svg class="w-4 h-4 mt-0.5 text-brand shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-muted-light">{benefit}</span>
                </div>
              ))}
            </div>

            <!-- Ideal for -->
            <div class="mt-auto pt-5 border-t border-surface-light">
              <div class="inline-block px-3 py-1.5 rounded-lg text-xs border border-surface-light bg-canvas text-muted">
                Ideal for: {service.ideal}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center" data-animate>
      <a href={PERSONAL.callUrl} target={PERSONAL.callUrl.startsWith("https:") ? "_blank" : undefined} rel="noopener noreferrer" class="text-brand hover:text-brand-light transition-colors text-sm">
        Let's discuss what works for you →
      </a>
      <p class="mt-4 text-sm text-muted">
        For more about my company's services,
        <a href={COMPANY.url} target="_blank" rel="noopener noreferrer" class="text-brand underline underline-offset-4 hover:text-brand-light">explore {COMPANY.name} →</a>
      </p>
    </div>
  </div>
</section>
