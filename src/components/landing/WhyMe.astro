---
import { EXPERTISE, COMPANY } from '../../config';

// Icon mapping
const icons = {
  automation: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
  </svg>`,
  vision: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
  </svg>`,
  strategy: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
  </svg>`,
  scale: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
  </svg>`,
};
---

<section id="why-me" class="relative">
  <div class="section-container">
    
    <!-- Section header -->
    <div class="section-header" data-animate>
      <span class="section-label">How I Help</span>
      <h2 class="section-title">AI that solves real problems.</h2>
      <p class="section-subtitle">
        I don't chase trends. I focus on AI applications that create measurable business value — 
        the kind of results you can show to your board.
      </p>
    </div>

    <!-- Expertise cards -->
    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {EXPERTISE.map((item) => (
        <div 
          class="card group"
          data-animate
        >
          <div class="flex items-start gap-5">
            <div class="icon-container text-brand shrink-0 group-hover:border-brand/30 transition-colors">
              <Fragment set:html={icons[item.icon as keyof typeof icons]} />
            </div>
            <div>
              <h3 class="text-xl font-display font-medium text-ink mb-3">
                {item.title}
              </h3>
              <p class="text-muted-light leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Differentiator callout -->
    <div class="mt-10 md:mt-12 max-w-3xl mx-auto" data-animate>
      <div class="relative bg-surface border border-surface-light rounded-2xl p-8 md:p-10">
        <div class="absolute top-0 left-8 w-px h-full bg-brand/20"></div>
        
        <div class="pl-8">
          <h3 class="text-xl md:text-2xl font-display font-medium text-ink mb-4">
            The difference? I've been here before.
          </h3>
          <p class="text-muted-light leading-relaxed mb-6">
            Most AI consultants give you a strategy deck and wish you luck. I've been the Head of AI 
            at startups and the Lead Architect at global consultancies. I know what works in theory 
            <em class="text-ink">and</em> what survives contact with production.
          </p>
          <p class="text-muted-light leading-relaxed mb-6">
            I run <a href={COMPANY.url} target="_blank" rel="noopener noreferrer" class="text-brand underline underline-offset-4 hover:text-brand-light">{COMPANY.name}</a>,
            an AI engineering company focused on bringing AI systems into production—from agentic workflows to technical leadership.
          </p>
          <div class="flex flex-wrap gap-6 text-sm">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
              <span class="text-muted-light">Strategy that's actually implementable</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
              <span class="text-muted-light">Code you can hand to your team</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
              <span class="text-muted-light">Results you can measure</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
