---
import { SELECTED_BUILDS } from '../../config';
---

<section id="selected-builds" class="bg-surface-muted border-y border-surface-light">
  <div class="section-container">
    <div class="section-header" data-animate>
      <span class="section-label">Selected Builds</span>
      <h2 class="section-title">Inside the systems I've built.</h2>
      <p class="section-subtitle">Selected work across company roles, direct client engagements, and Upwork projects.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {SELECTED_BUILDS.map((project) => (
        <article class="card flex flex-col" data-animate>
          <p class="text-xs font-medium text-brand mb-4">{project.category}</p>
          <h3 class="text-xl font-medium mb-4">{project.title}</h3>
          <p class="text-muted mb-6">{project.description}</p>
          <ul class="flex flex-wrap gap-2 mt-auto mb-6" aria-label="Technologies used">
            {project.technologies.map((technology) => (
              <li class="text-xs px-2.5 py-1 rounded-md bg-brand-soft text-brand">{technology}</li>
            ))}
          </ul>
          <a href={project.source} target="_blank" rel="noopener noreferrer" class="text-sm text-brand font-medium underline underline-offset-4" aria-label={`View ${project.title} on Upwork`}>
            Project details →
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
