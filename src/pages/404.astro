---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title = "404: Not Found" includeSidebar={false}>
  <div class="text-center">
    <div aria-hidden="true" class="text-8xl mb-6">🏝</div>
    <h1 class="text-8xl sm:text-9xl font-bold mb-4">404</h1>
    <p class="text-lg sm:text-2xl">The page you're looking for couldn't be found.</p>
    <a class="btn-primary mt-9" href="/">Home</a>
  </div>
</BaseLayout>
