---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Navbar from '../../components/landing/Navbar.astro';
import Footer from '../../components/landing/Footer.astro';
import { CASE_STUDIES } from '../../data/case-studies';
import { PERSONAL } from '../../config';

export function getStaticPaths() {
  return CASE_STUDIES.map(study => ({ params: { slug: study.slug }, props: { study } }));
}
const { study } = Astro.props;
const next = CASE_STUDIES[(CASE_STUDIES.findIndex(item => item.slug === study.slug) + 1) % CASE_STUDIES.length];
---
<LandingLayout title={`${study.company} case study | Gaber Youssef`} description={study.description}>
  <Navbar />
  <main class="case-study">
    <header class="case-intro">
      <a href="/#results" class="back-link">← All results</a>
      <p class="section-label">Case study · {study.company}</p>
      <h1>{study.title}</h1>
      <p class="case-lead">{study.introduction}</p>
      <dl class="case-facts">
        <div><dt>My role</dt><dd>{study.role}</dd></div>
        <div><dt>Period</dt><dd>{study.period}</dd></div>
        <div><dt>Domain</dt><dd>{study.industry}</dd></div>
      </dl>
    </header>
    <div class="case-body">
      <article>
        <section aria-labelledby="challenge"><h2 id="challenge">The challenge</h2><p>{study.challenge}</p></section>
        <section aria-labelledby="contribution"><h2 id="contribution">My contribution</h2><p>{study.contribution}</p></section>
        <section aria-labelledby="system">
          <h2 id="system">{study.systemTitle}</h2>
          <ol class="system-steps">
            {study.system.map((step, index) => <li><span class="step-number" aria-hidden="true">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}
          </ol>
        </section>
        <section aria-labelledby="outcome"><h2 id="outcome">The outcome</h2><p>{study.result}</p></section>
        {'quote' in study && <blockquote><p>“{study.quote}”</p><cite>{study.quoteBy}</cite><a href={study.quoteSource} target="_blank" rel="noopener noreferrer" class="text-sm text-brand underline underline-offset-4 inline-block mt-3">Read the review on Upwork ↗</a></blockquote>}
      </article>
      <aside aria-label="Project summary">
        <div class="outcome-card">
          <p class="case-metric">{study.metric}</p><p class="metric-label">{study.metricLabel}</p>
          <ul class="case-tags">{study.tags.map(tag => <li>{tag}</li>)}</ul>
          <a href={study.companyUrl} target="_blank" rel="noopener noreferrer">Visit {study.company} ↗</a>
          {'reference' in study && <a href={study.reference} target="_blank" rel="noopener noreferrer">Additional project reference on Upwork ↗</a>}
        </div>
      </aside>
    </div>
    <footer class="case-next">
      <div><h2>Have a similar challenge?</h2><p>Let’s discuss what it would take to bring your AI system into production.</p><a class="btn-primary" href={PERSONAL.callUrl}>Arrange a strategy call →</a></div>
      <a class="next-study" href={`/work/${next.slug}/`}><span>Next case study</span><strong>{next.company} →</strong></a>
    </footer>
  </main>
  <Footer />
</LandingLayout>
<style>
  .case-study { max-width: 1152px; margin: auto; padding: 112px 24px 64px; }
  .case-intro { padding-bottom: 40px; border-bottom: 1px solid #DDE3EC; }
  .back-link { display: block; width: fit-content; color: #566278; font-size: 14px; margin-bottom: 40px; }
  h1 { max-width: 900px; font-size: clamp(2.1rem, 4.5vw, 3.6rem); line-height: 1.12; letter-spacing: -.035em; text-wrap: balance; }
  .case-lead { font-size: 20px; max-width: 780px; margin-top: 24px; color: #566278; }
  .case-facts { display: grid; gap: 24px; margin-top: 32px; }
  dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: #566278; margin-bottom: 6px; }
  dd { color: #152238; font-size: 16px; }
  .case-body { display: grid; gap: 32px; padding-top: 40px; }
  article { min-width: 0; }
  article section { margin-bottom: 36px; }
  h2 { font-size: 26px; line-height: 1.25; letter-spacing: -.02em; margin-bottom: 16px; }
  article p { font-size: 17px; line-height: 1.8; }
  .system-steps { list-style: none; padding: 0; border-top: 1px solid #DDE3EC; }
  .system-steps li { display: flex; gap: 20px; padding: 22px 0; border-bottom: 1px solid #DDE3EC; }
  .step-number { font-size: 14px; color: #2457E6; padding-top: 3px; }
  h3 { font-size: 18px; font-weight: 600; margin-bottom: 4px; }
  .system-steps p { font-size: 16px; color: #566278; }
  .outcome-card { padding: 28px; background: #EEF3FF; border-radius: 16px; }
  .case-metric { font-size: 48px; line-height: 1.1; letter-spacing: -.04em; color: #2457E6; }
  .metric-label { color: #566278; margin-top: 8px; }
  .case-tags { display: flex; flex-wrap: wrap; gap: 8px; padding: 24px 0; list-style: none; }
  .case-tags li { font-size: 13px; padding: 5px 10px; border-radius: 6px; background: #fff; }
  .outcome-card a { display: block; font-size: 14px; color: #2457E6; text-decoration: underline; text-underline-offset: 4px; margin-top: 16px; }
  blockquote { border-left: 3px solid #2457E6; padding-left: 24px; margin: 40px 0; }
  blockquote p { font-style: italic; }
  cite { display: block; font-size: 14px; font-style: normal; color: #566278; margin-top: 16px; }
  .case-next { display: grid; gap: 32px; border-top: 1px solid #DDE3EC; padding-top: 36px; margin-top: 24px; }
  .case-next p { max-width: 600px; margin-bottom: 24px; }
  .next-study { display: grid; gap: 8px; align-content: center; color: #2457E6; }
  .next-study span { color: #566278; font-size: 14px; }
  .next-study strong { font-size: 22px; font-weight: 500; }
  @media (min-width: 640px) { .case-facts { grid-template-columns: 1fr 1fr 1.5fr; } }
  @media (min-width: 1024px) {
    .case-study { padding-top: 128px; }
    .case-body { grid-template-columns: minmax(0, 1fr) 300px; gap: 80px; padding-top: 48px; }
    .outcome-card { position: sticky; top: 104px; }
    .case-next { grid-template-columns: 1fr 240px; gap: 80px; }
  }
</style>
