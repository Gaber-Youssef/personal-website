---
import BaseHead from '../components/BaseHead.astro';
import { ViewTransitions } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from '../config';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = SITE_TITLE, 
  description = SITE_DESCRIPTION,
  image 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body class="min-h-screen">
    
    <!-- Main content -->
    <slot />
    
    <!-- Smooth scroll and intersection observer for animations -->
    <script>
      let observer: IntersectionObserver | undefined;

      function initAnimations() {
        observer?.disconnect();
        const elements = document.querySelectorAll<HTMLElement>('[data-animate]');
        elements.forEach(el => el.classList.remove('animate-pending'));
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
            !('IntersectionObserver' in window)) return;

        observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('animate-pending');
              entry.target.dataset.revealed = 'true';
              observer?.unobserve(entry.target);
            }
          });
        }, { threshold: 0, rootMargin: '0px 0px 48px 0px' });

        elements.forEach(el => {
          // Keep content already on screen visible, including anchor destinations.
          if (el.dataset.revealed || el.getBoundingClientRect().top < window.innerHeight) {
            el.dataset.revealed = 'true';
            return;
          }
          el.classList.add('animate-pending');
          observer?.observe(el);
        });
      }

      initAnimations();
      document.addEventListener('astro:page-load', initAnimations);
      document.addEventListener('astro:before-swap', () => observer?.disconnect());
    </script>
    
    <style is:global>
      /* Animation states */
      [data-animate] {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                    transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      }

      [data-animate].animate-pending {
        opacity: 0;
        transform: translateY(12px);
      }

      @media (prefers-reduced-motion: reduce) {
        [data-animate].animate-pending {
          opacity: 1;
          transform: none;
        }
      }

    </style>
  </body>
</html>



